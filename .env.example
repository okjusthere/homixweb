# Copy to .env.local and fill in. .env.local is gitignored.

# --- Listings data source ---------------------------------------------------
# Homix website reads OneKey MLS data only through the BBO backend. It does not
# keep a local MLS cache and does not call OneKey/MLSGrid directly.
BBO_API_URL=https://onekey.kevv.ai
BBO_API_KEY=
BBO_HOMIX_LIST_OFFICE_MLS_ID=KEYHRMI01
BBO_HOMIX_LIST_OFFICE_KEY=KEY421354028
BBO_REVALIDATE_SECONDS=300
# Shared only with BBO. Authorizes event-driven listing cache invalidation.
BBO_REVALIDATE_SECRET=

# --- Advisor profiles (Supabase) --------------------------------------------
# When set, advisor profiles are read from Supabase. Advisors self-edit from the
# agents.homixny.com portal (which forwards to /api/agent-profile), and admins
# manage the roster there too (/api/agent-admin). Leave blank for the static roster.
# From Supabase: Project Settings -> API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Shared server-to-server secret with the agents.homixny.com portal — authorizes
# the profile-edit, roster-admin, and cache-revalidate calls. Must match the
# portal's AGENTS_REVALIDATE_SECRET.
AGENTS_REVALIDATE_SECRET=

# --- Website inquiries ------------------------------------------------------
# Contact forms write to Supabase public.inquiries and send an email through
# Resend. Verify the sending domain in Resend before launch.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=homix@homixny.com
INQUIRY_FROM_EMAIL="Homix Website <inquiries@homixny.com>"
# Optional comma-separated internal copies.
INQUIRY_BCC_EMAIL=

# --- Site ------------------------------------------------------------------
# Public origin, used for canonical URLs, sitemap.xml and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.homixny.com

# Fully automated Homix News. The newsroom uses the dedicated Azure OpenAI
# deployment directly and does not use Vercel AI Gateway.
CRON_SECRET=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_RESPONSES_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_IMAGE_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/images/generations?api-version=preview
AZURE_OPENAI_IMAGE_API_KEY=
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2
